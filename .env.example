# Supabase Project Configuration (Template)
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_REGION=ap-south-1
SUPABASE_URL=https://your-project-id.supabase.co

# API Keys
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database Credentials
DB_USER=postgres.your-project-id
DB_PASSWORD=your-db-password
DB_NAME=postgres

# Connection Strings
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_DIRECT_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres?sslmode=require

# Server Configuration
PORT=3000
JWT_SECRET=your-secret-key-here
NODE_ENV=development
